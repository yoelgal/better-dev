#!/usr/bin/env bash
# Legacy-path shim - re-exposes the root hook of the same name at the path better-dev occupied under
# the 0.7.0 monorepo layout. New behaviour: none. Rationale and removal condition: D34.
#
# The one thing worth knowing here: do not delete this because the tree looks flat. A host installed
# before the flatten runs an ABSOLUTE command pointing at this path, so without this file it exits 127
# and no hook code runs at all.
#
# Silent by construction - exec, never echo. One of the three hooks this stands in for emits a strict
# JSON object, so any output added here would corrupt it.
set -eu
root="$(cd "$(dirname "$0")/../.." 2>/dev/null && pwd -P)" || exit 0
real="$root/hooks/$(basename "$0")"
# A partial or interrupted pull must not break every session - a shim that cannot find its target
# says nothing and gets out of the way.
[ -x "$real" ] || exit 0
exec bash "$real" "$@"
