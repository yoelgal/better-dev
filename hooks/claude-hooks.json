{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/claude-session.js\"",
            "timeout": 5,
            "statusMessage": "Loading better-dev comms..."
          }
        ]
      }
    ]
  }
}
