#!/usr/bin/env python3
"""bd-omp-hook-wire - register better-dev's awareness bridge in omp's own hooks dir.

omp (Oh My Pi) has no machine-global command-hook config: SessionStart, SubagentStart and PreToolUse
do not exist in it. An omp hook is a TypeScript module dropped at ~/.omp/agent/hooks/pre/*.ts which
default-exports (pi) => void and subscribes with pi.on(...). So omp's wiring is not a JSON merge like
bd-hook-wire's - it is installing ONE file at ONE path, and that is the whole difference between the
two scripts. install.sh reaches this one through the host adapter's `bd_host_hook_wire`; bd-hook-wire
stays the default for every host that does own a hook config.

  bd-omp-hook-wire wire   <clone-dir> <target-path>   install the bridge stub; print a status word
  bd-omp-hook-wire plan   <clone-dir> <target-path>   same decision, but write nothing
  bd-omp-hook-wire unwire <clone-dir> <target-path>   remove the stub, but only if it is ours
  bd-omp-hook-wire selftest

What lands at <target-path> is a real three-line stub that re-exports the default of
<clone-dir>/hooks/omp/bd-awareness.ts by absolute path. It cannot be a symlink: omp's hook discovery
silently skips symlinked modules - no warning, no log line, the hook simply never loads - while a
byte-identical regular file at the same path loads and injects. It is not a copy either, because the
logic has to stay in the clone for `git pull` to refresh it. So the clone path is templated into the
stub, and a moved clone needs an install.sh re-run - the same re-run its skills already need.

Status word on stdout, one of: wired | would-wire | current | unwired | unreadable. Never raises at
the caller, and never writes over anything that is not ours: the target is a path in the operator's
own hooks dir, so a file there that we did not put there is reported and left byte-identical rather
than clobbered. `unwire` is bd-uninstall's half - a stub left behind after the clone is gone would
run a hook pointing at a deleted path in every omp session.
"""
import json
import os
import pathlib
import subprocess
import sys
import tempfile

# Where the module lives inside the clone. The stub re-exports it by absolute path.
MODULE = "hooks/omp/bd-awareness.ts"

# The stub's literal second line, and the only ours-test there is: it identifies the file we wrote,
# and it also identifies a module left by the symlink install this stub replaced, because the marker
# reads back the same through a link. Slice B's module carries it too; keep the two in step.
MARKER = "// better-dev-omp-hook"

# First line of the stub. Operator-facing: the file is in their own hooks dir and says so.
BANNER = "// better-dev omp awareness hook - installed by better-dev's install.sh, do not edit"

# A regular file at the target is the operator's hook until proven otherwise, so read only enough of
# it to find the marker line rather than pulling an arbitrary file into memory.
HEAD = 4096


def stub(module):
    # json.dumps rather than a bare quote pair: the clone path is interpolated into a TypeScript
    # string literal, and a quote or a backslash anywhere in it would make the hook a parse error.
    return ("%s\n%s\nexport { default } from %s;\n"
            % (BANNER, MARKER, json.dumps(str(module)))).encode("utf-8")


def marked(p):
    with open(str(p), "rb") as fh:
        head = fh.read(HEAD)
    for line in head.decode("utf-8", "replace").splitlines():
        if line.strip() == MARKER:
            return True
    return False


def classify(p):
    """absent | ours | foreign. Raises OSError, which every caller turns into `unreadable`."""
    if not p.exists():
        # A dangling symlink lands here and is replaced rather than reported: it has no content to
        # run the ours-test on, and the one that turns up in the field is better-dev's own - left by
        # the symlink install this stub replaced, dangling since the clone moved.
        return "absent"
    if not p.is_file():
        return "foreign"
    return "ours" if marked(p) else "foreign"


def install(p, want):
    # Build beside the target and rename over it: the operator's session may load this dir at any
    # moment, and a delete-then-create leaves a window with no hook and, on a failed create, none.
    # os.replace also swaps out a symlink at the target without following it.
    fd, tmp = tempfile.mkstemp(dir=str(p.parent), prefix=".bd-omp-hook.")
    try:
        with os.fdopen(fd, "wb") as fh:
            fh.write(want)
        os.chmod(tmp, 0o644)
        os.replace(tmp, str(p))
    except OSError:
        if os.path.lexists(tmp):
            os.unlink(tmp)
        raise


def apply(src, target, dry=False, remove=False):
    p = pathlib.Path(target)
    # Absolute, because the stub's specifier is resolved from wherever omp loads it, not from here.
    module = pathlib.Path(os.path.abspath(src)) / MODULE

    try:
        state = classify(p)
    except OSError:
        return "unreadable"
    if remove:
        # A foreign file is nothing of ours to remove, which is `current`, not a failure: an
        # uninstall that reported `unreadable` over the operator's own hook would read as a broken
        # uninstall when it did exactly the right thing.
        if state != "ours":
            return "current"
        try:
            p.unlink()
        except OSError:
            return "unreadable"
        return "unwired"

    if state == "foreign":
        return "unreadable"

    try:
        # The source is checked before anything is written, because a stub re-exporting a module
        # that is not there would throw inside omp's loader on every session.
        if not module.is_file():
            return "unreadable"
        want = stub(module)
        # Byte comparison, so a stub naming a clone that has since moved counts as out of date.
        if state == "ours" and p.read_bytes() == want:
            return "current"
        if dry:
            return "would-wire"
        p.parent.mkdir(parents=True, exist_ok=True)
        install(p, want)
    except OSError:
        return "unreadable"
    return "wired"


def selftest():
    self = os.path.abspath(__file__)
    fails = []

    def check(cond, what):
        if not cond:
            fails.append(what)

    def run(mode, src, target):
        out = subprocess.run(
            [sys.executable, self, mode, str(src), str(target)],
            capture_output=True, text=True,
        )
        return out.stdout.strip()

    def clone(root, name, module=True):
        c = pathlib.Path(root) / name
        m = c / MODULE
        m.parent.mkdir(parents=True, exist_ok=True)
        if module:
            m.write_text("export default (pi) => {};\n%s\n" % MARKER)
        return c, m

    # Tolerates a missing file so a broken run reports its failed check instead of dying on the
    # read that follows it.
    def text(p):
        return p.read_text() if p.is_file() else ""

    def line(p, n):
        ls = text(p).splitlines()
        return ls[n] if len(ls) > n else ""

    def spec(module):
        return 'export { default } from "%s";' % os.path.abspath(str(module))

    with tempfile.TemporaryDirectory() as d:
        here, mod = clone(d, "clone")
        pre = pathlib.Path(d) / "omp" / "agent" / "hooks" / "pre"
        tgt = pre / "bd-awareness.ts"

        # 1. absent target, source present: a REAL file lands - a symlink here is the whole defect
        # this stub exists for, because omp's hook discovery skips symlinked modules in silence.
        check(run("wire", here, tgt) == "wired", "absent target not wired")
        check(not tgt.is_symlink(), "wire installed a symlink, which omp would never load")
        check(tgt.is_file(), "wire did not leave a regular file")
        check(len(text(tgt).splitlines()) == 3, "stub is not three lines")
        check(line(tgt, 1) == MARKER, "second line is not the ours-marker: %r" % line(tgt, 1))
        check(line(tgt, 2) == spec(mod), "third line does not name the clone: %r" % line(tgt, 2))

        # 2. idempotent: a second run changes nothing
        check(run("wire", here, tgt) == "current", "re-run not idempotent")

        # 3. a moved clone rewrites our stub rather than adding a second one. Two modules in omp's
        # hooks/pre dir would both load, and the stale one re-exports a clone that is gone.
        moved, moved_mod = clone(d, "moved")
        check(run("wire", moved, tgt) == "wired", "moved clone not rewired")
        check(line(tgt, 2) == spec(moved_mod), "stale clone path survived: %r" % line(tgt, 2))
        left = sorted(x.name for x in pre.iterdir()) if pre.is_dir() else []
        check(left == ["bd-awareness.ts"], "moved clone left %r in hooks/pre" % left)

        # 4. a stub naming a clone that has moved is out of date, not current - the ours-marker
        # alone cannot see that, only the whole desired content can.
        check(run("plan", here, tgt) == "would-wire", "plan called a stale clone path current")
        check(line(tgt, 2) == spec(moved_mod), "plan rewrote the stub")

        # 5. unwire removes it, and a second unwire is a no-op
        check(run("unwire", moved, tgt) == "unwired", "unwire did not report removal")
        check(not os.path.lexists(str(tgt)), "unwire left the target behind")
        check(run("unwire", moved, tgt) == "current", "second unwire was not a no-op")

        # 6. plan writes nothing
        fresh = pathlib.Path(d) / "plan" / "bd-awareness.ts"
        check(run("plan", here, fresh) == "would-wire", "plan did not report would-wire")
        check(not os.path.lexists(str(fresh)), "plan wrote a file")

        # 7. a foreign file at the target is the operator's own hook: reported, never overwritten,
        # never removed by unwire either
        foreign = pathlib.Path(d) / "foreign.ts"
        body = "export default (pi) => { pi.on('session_start', () => {}); };\n"
        foreign.write_text(body)
        check(run("wire", here, foreign) == "unreadable", "foreign file not reported")
        check(text(foreign) == body, "foreign file was modified by wire")
        check(run("unwire", here, foreign) == "current", "unwire claimed a foreign file")
        check(text(foreign) == body, "foreign file was modified by unwire")
        check(run("plan", here, foreign) == "unreadable", "plan did not report a foreign file")

        # 8. missing source module: nothing is installed, so omp never loads a stub that throws
        empty, _ = clone(d, "empty", module=False)
        dangle = pathlib.Path(d) / "dangle" / "bd-awareness.ts"
        check(run("wire", empty, dangle) == "unreadable", "missing source not reported")
        check(not os.path.lexists(str(dangle)), "missing source installed a stub")
        check(run("plan", empty, dangle) == "unreadable", "plan did not report a missing source")

    if fails:
        for f in fails:
            print("FAIL: " + f, file=sys.stderr)
        print("selftest FAILED", file=sys.stderr)
        return 1
    print("selftest OK")
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    cmd = argv[0]
    if cmd == "selftest":
        return selftest()
    if cmd in ("wire", "plan", "unwire"):
        if len(argv) != 3:
            print("bd-omp-hook-wire: %s needs <clone-dir> <target-path>" % cmd, file=sys.stderr)
            return 1
        print(apply(argv[1].rstrip("/"), argv[2],
                    dry=(cmd == "plan"), remove=(cmd == "unwire")))
        return 0
    print("bd-omp-hook-wire: unknown command '%s' (wire | plan | unwire | selftest)" % cmd,
          file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
