#!/usr/bin/env python3
"""bd-hook-wire - register better-dev's awareness hooks in a host's machine-global hook config.

better-dev installs from a clone (git clone + install.sh), and a host only fires the hooks named in
its own machine-global config - hooks/hooks.json declares the SessionStart/SubagentStart hooks the
tool ships, but nothing reads that file out of the clone. This script is what puts them in the host's
config. Without it an install links every skill and registers no hook - in every repo, forever, while
BOOTSTRAP claims the tool ships hooks. install.sh calls this; /bootstrap-hooks is the by-hand path.

  bd-hook-wire wire   <clone-dir> <settings.json>   merge our entries in; print a status word
  bd-hook-wire plan   <clone-dir> <settings.json>   same, but write nothing
  bd-hook-wire unwire <clone-dir> <settings.json>   remove our entries, leave foreign ones
  bd-hook-wire selftest

Status word on stdout, one of: wired | would-wire | current | unwired | unreadable. Never raises at
the caller: a host config we cannot parse is left untouched and reported, because a hook wiring step
must never cost the operator their own settings. `unwire` is bd-uninstall's half - an uninstall that
removed the clone but left its hook entries would fire a command pointing at a deleted path on every
session, which is worse than the hookless install this script exists to fix.
"""
import json
import os
import pathlib
import subprocess
import sys
import tempfile

# Ours-test by script basename under a hooks/ dir: only better-dev writes commands in that shape, so a
# re-run after the clone moves replaces its own stale entries and never touches a foreign hook.
OURS = ("bd-session-start", "bd-subagent-start", "bd-graphify-refresh-stale")

# Mirrors hooks/hooks.json's awareness half. The bd-guard PreToolUse hooks are deliberately NOT here:
# those enforce a repo's blast-radius policy and belong to /guardrails-install, which records that
# policy per repo. This script wires only what is machine-global and repo-agnostic.
WANT = {
    "SessionStart": [
        ("startup|resume|clear|compact", "bd-session-start"),
        ("startup|resume", "bd-graphify-refresh-stale"),
    ],
    "SubagentStart": [(None, "bd-subagent-start")],
}


def entry(src, matcher, script):
    posix = "%s/hooks/%s" % (src, script)
    win = posix.replace("/", "\\")
    hook = {
        "type": "command",
        "command": 'bash "%s"' % posix,
        "commandWindows": (
            'if (Get-Command bash -ErrorAction SilentlyContinue) { bash "%s" }' % win
        ),
        "timeout": 5,
    }
    return {"hooks": [hook]} if matcher is None else {"matcher": matcher, "hooks": [hook]}


def is_ours(e):
    if not isinstance(e, dict):
        return False
    for h in e.get("hooks", []) or []:
        cmd = h.get("command", "") if isinstance(h, dict) else ""
        for name in OURS:
            if ("/hooks/" + name) in cmd or ("\\hooks\\" + name) in cmd:
                return True
    return False


def apply(src, target, dry=False, remove=False):
    p = pathlib.Path(target)
    try:
        raw = p.read_text() if p.exists() else ""
        d = json.loads(raw) if raw.strip() else {}
    except (OSError, ValueError):
        return "unreadable"
    if not isinstance(d, dict):
        return "unreadable"

    if remove:
        hooks = d.get("hooks")
        if not isinstance(hooks, dict):
            return "current"
        dropped = False
        for event in list(hooks):
            existing = hooks.get(event)
            if not isinstance(existing, list):
                continue
            kept = [e for e in existing if not is_ours(e)]
            if len(kept) == len(existing):
                continue
            dropped = True
            # Drop the event key entirely when nothing of the operator's remains, rather than
            # leaving an empty list behind as litter in a file we do not own.
            if kept:
                hooks[event] = kept
            else:
                del hooks[event]
        if not dropped:
            return "current"
        if not hooks:
            del d["hooks"]
        p.write_text(json.dumps(d, indent=2) + "\n")
        return "unwired"

    hooks = d.setdefault("hooks", {})
    if not isinstance(hooks, dict):
        return "unreadable"

    # Compare only OUR entries against what we want, and rebuild an event only when those differ.
    # A whole-document diff would report a rewrite every run purely because rebuilding the list
    # reorders the operator's foreign hooks - churn in their file, and a re-run that never says
    # "already registered". Their entries keep their order; we append ours after them.
    changed = False
    for event, wants in WANT.items():
        existing = hooks.get(event, [])
        if not isinstance(existing, list):
            existing = []
        desired = [entry(src, m, s) for m, s in wants]
        if [e for e in existing if is_ours(e)] == desired:
            continue
        hooks[event] = [e for e in existing if not is_ours(e)] + desired
        changed = True

    if not changed:
        return "current"
    if dry:
        return "would-wire"
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(d, indent=2) + "\n")
    return "wired"


def selftest():
    self = os.path.abspath(__file__)
    fails = []

    def check(cond, what):
        if not cond:
            fails.append(what)

    def run(mode, target, src="/clone/better-dev"):
        out = subprocess.run(
            [sys.executable, self, mode, src, str(target)],
            capture_output=True, text=True,
        )
        return out.stdout.strip()

    with tempfile.TemporaryDirectory() as d:
        cfg = pathlib.Path(d) / "settings.json"

        # 1. absent config: wired from nothing, and the file parses with all three entries
        check(run("wire", cfg) == "wired", "absent config not wired")
        got = json.loads(cfg.read_text())
        cmds = [
            h["command"]
            for ev in got["hooks"].values()
            for e in ev
            for h in e["hooks"]
        ]
        check(len(cmds) == 3, "expected 3 hook commands, got %d" % len(cmds))
        check(
            any("/hooks/bd-session-start" in c for c in cmds),
            "session-start hook missing",
        )
        check(
            any("/hooks/bd-subagent-start" in c for c in cmds),
            "subagent-start hook missing",
        )

        # 2. idempotent: a second run changes nothing
        check(run("wire", cfg) == "current", "re-run not idempotent")

        # 3. foreign hooks survive, and a foreign SessionStart entry is not dropped
        d2 = json.loads(cfg.read_text())
        d2["hooks"]["SessionStart"].append(
            {"matcher": "startup", "hooks": [{"type": "command", "command": "echo other"}]}
        )
        d2["permissions"] = {"allow": ["Bash(ls:*)"]}
        cfg.write_text(json.dumps(d2, indent=2))
        check(run("wire", cfg) == "current", "foreign entry forced a rewrite")
        got = json.loads(cfg.read_text())
        check(got.get("permissions", {}).get("allow") == ["Bash(ls:*)"], "foreign key lost")
        check(
            any(
                h["command"] == "echo other"
                for e in got["hooks"]["SessionStart"]
                for h in e["hooks"]
            ),
            "foreign SessionStart hook lost",
        )

        # 4. a moved clone replaces our stale entries rather than duplicating them
        check(run("wire", cfg, src="/moved/better-dev") == "wired", "moved clone not rewired")
        got = json.loads(cfg.read_text())
        ours = [
            h["command"]
            for ev in got["hooks"].values()
            for e in ev
            for h in e["hooks"]
            if any(("/hooks/" + n) in h["command"] for n in OURS)
        ]
        check(len(ours) == 3, "moved clone duplicated entries (%d)" % len(ours))
        check(all("/moved/" in c for c in ours), "stale clone path survived")

        # 5. unwire removes only ours; the operator's own hooks and keys survive, and a second
        # unwire is a no-op. An uninstall that left our entries behind would run a command pointing
        # at a deleted clone on every session.
        check(run("unwire", cfg) == "unwired", "unwire did not report removal")
        got = json.loads(cfg.read_text())
        left = [
            h["command"]
            for ev in got.get("hooks", {}).values()
            for e in ev
            for h in e["hooks"]
        ]
        check(left == ["echo other"], "unwire left %r instead of the foreign hook alone" % left)
        check(got.get("permissions", {}).get("allow") == ["Bash(ls:*)"], "unwire lost a foreign key")
        check("SubagentStart" not in got.get("hooks", {}), "emptied event key left behind")
        check(run("unwire", cfg) == "current", "second unwire was not a no-op")

        # 6. plan writes nothing
        fresh = pathlib.Path(d) / "plan.json"
        check(run("plan", fresh) == "would-wire", "plan did not report would-wire")
        check(not fresh.exists(), "plan wrote a file")

        # 7. unparseable config is reported and left byte-identical
        bad = pathlib.Path(d) / "bad.json"
        bad.write_text("{ not json")
        check(run("wire", bad) == "unreadable", "malformed config not reported")
        check(bad.read_text() == "{ not json", "malformed config was modified")

    if fails:
        for f in fails:
            print("FAIL: " + f, file=sys.stderr)
        print("selftest FAILED", file=sys.stderr)
        return 1
    print("selftest OK")
    return 0


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    cmd = argv[0]
    if cmd == "selftest":
        return selftest()
    if cmd in ("wire", "plan", "unwire"):
        if len(argv) != 3:
            print("bd-hook-wire: %s needs <clone-dir> <settings.json>" % cmd, file=sys.stderr)
            return 1
        print(apply(argv[1].rstrip("/"), argv[2],
                    dry=(cmd == "plan"), remove=(cmd == "unwire")))
        return 0
    print("bd-hook-wire: unknown command '%s' (wire | plan | unwire | selftest)" % cmd,
          file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
