/* the lit accent has to be a rule, not a presentation attribute: `.n rect`'s stroke above would
   outrank an attribute (specificity 0), so setting stroke="..." on the rect draws nothing. The
   per-community entry colour goes on `rect.style` in paint()'s sibling for the same reason. */
.n.lit rect { stroke: var(--accent); stroke-width: 2; }
.n.dim { opacity: .22; }
.n.sel rect { stroke: var(--ink); stroke-width: 2; }
.e { stroke: #33414f; stroke-width: 1.1; fill: none; }
.e.lit { stroke: var(--accent); stroke-width: 2; }
.e.dim { opacity: .12; }
.badge { display: inline-block; padding: 1px 7px; border-radius: 999px; font-size: 11px;
  background: var(--panel-2); border: 1px solid var(--line); color: var(--ink-dim); }
.flow { width: 100%; text-align: left; background: none; border: 0; border-radius: 7px;
  color: inherit; font: inherit; padding: 7px 8px; cursor: pointer; display: grid; gap: 2px; }
.flow:hover { background: var(--panel-2); }
.flow.on { background: var(--panel-2); box-shadow: 0 0 0 1px var(--accent) inset; }
.flow .nm { font-weight: 560; font-size: 13px; }
.flow .st { color: var(--ink-faint); font-size: 11.5px; }
.flow.none .st { color: #e08a6b; }
ol.steps { margin: 8px 0 0; padding-left: 0; list-style: none; display: grid; gap: 4px; }
ol.steps li { display: grid; grid-template-columns: 20px minmax(0, 1fr); gap: 8px;
  font-size: 12px; color: var(--ink-dim); }
ol.steps li b { color: var(--ink); font-weight: 560; }
ol.steps li .k { color: var(--ink-faint); font-family: var(--mono); font-size: 11px; }
ol.steps li .hop { color: var(--accent); font-family: var(--mono); }
.kv { display: grid; grid-template-columns: 74px minmax(0, 1fr); gap: 3px 8px; font-size: 12.5px; }
.kv dt { color: var(--ink-faint); }
.kv dd { margin: 0; overflow-wrap: anywhere; }
pre.cmd { margin: 10px 0 0; padding: 8px 10px; background: #0b0f14; border: 1px solid var(--line);
  border-radius: 7px; font-family: var(--mono); font-size: 11.5px; color: #b7e2ff;
  white-space: pre-wrap; overflow-wrap: anywhere; }
ul.edges { margin: 8px 0 0; padding: 0; list-style: none; display: grid; gap: 3px;
  max-height: 210px; overflow: auto; }
ul.edges li { font-size: 12px; color: var(--ink-dim); overflow: hidden;
  text-overflow: ellipsis; white-space: nowrap; }
ul.edges li .rel { color: var(--ink-faint); font-family: var(--mono); font-size: 11px; }
ul.edges li button { background: none; border: 0; color: var(--accent); font: inherit;
  padding: 0; cursor: pointer; }
footer { padding: 14px 24px 26px; border-top: 1px solid var(--line); color: var(--ink-faint);
  font-size: 12px; display: flex; gap: 16px; flex-wrap: wrap; }
footer code { font-family: var(--mono); color: var(--ink-dim); }
.note { color: #e0c46b; font-size: 12px; }
"""

JS = r"""
var D = window.ATLAS_DATA;
var byId = {};                       // node id -> [communityIndex, nodeIndex]
D.communities.forEach(function (c, ci) {
  c.nodes.forEach(function (n, ni) { byId[n.id] = [ci, ni]; });
});
function nodeOf(id) { var p = byId[id]; return p ? D.communities[p[0]].nodes[p[1]] : null; }
function commOf(id) { var p = byId[id]; return p ? D.communities[p[0]] : null; }
function labelOf(id) { var n = nodeOf(id); return n ? n.label : id; }

// Adjacency is rebuilt from the per-community payload, so the same code path serves an
// aggregated (over-guard) page and a full one.
var adjOut = {}, adjIn = {};
function push(m, k, v) { (m[k] = m[k] || []).push(v); }
D.communities.forEach(function (c) {
  c.iedges.forEach(function (e) {
    push(adjOut, c.nodes[e[0]].id, c.nodes[e[1]].id);
    push(adjIn, c.nodes[e[1]].id, c.nodes[e[0]].id);
  });
  c.xedges.forEach(function (e) {
    var here = c.nodes[e[0]].id;
    if (e[3] === 'out') { push(adjOut, here, e[1]); push(adjIn, e[1], here); }
  });
});

var state = { open: null, highlight: {}, flow: null, sel: null };
var el = {
  cards: document.getElementById('cards'), stage: document.getElementById('stage'),
  view: document.getElementById('view'), title: document.getElementById('stage-title'),
  flows: document.getElementById('flows'), steps: document.getElementById('steps'),
  inspect: document.getElementById('inspect'), note: document.getElementById('note')
};

function setHighlight(ids, note) {
  state.highlight = {};
  ids.forEach(function (id) { if (byId[id]) state.highlight[id] = 1; });
  if (note !== undefined) el.note.textContent = note;
  paint();
}

function bfsPath(a, b) {
  if (a === b) return [a];
  var prev = {}, q = [a]; prev[a] = null;
  while (q.length) {
    var cur = q.shift(), nxt = adjOut[cur] || [];
    for (var i = 0; i < nxt.length; i++) {
      var n = nxt[i];
      if (n in prev) continue;
      prev[n] = cur;
      if (n === b) { var p = [n]; while (prev[p[p.length - 1]] !== null) p.push(prev[p[p.length - 1]]); return p.reverse(); }
      q.push(n);
    }
  }
  return [];
}
function reach(adj, a) {
  var seen = {}, q = [a]; seen[a] = 1;
  while (q.length) {
    var cur = q.shift(), nxt = adj[cur] || [];
    for (var i = 0; i < nxt.length; i++) if (!(nxt[i] in seen)) { seen[nxt[i]] = 1; q.push(nxt[i]); }
  }
  return Object.keys(seen);
}

function fragmentHighlight() {
  var m = /#highlight=([^&]+)/.exec(location.hash || '');
  if (!m) return false;
  var want = decodeURIComponent(m[1]).split(',').map(function (s) { return s.trim(); })
    .filter(function (s) { return s && byId[s]; });
  if (!want.length) { el.note.textContent = 'no graph node matched the #highlight fragment'; return true; }
  if (want.length === 1) {
    var blast = reach(adjIn, want[0]);
    setHighlight(blast, 'blast radius of ' + labelOf(want[0]) + ': ' + (blast.length - 1) + ' nodes reach it');
  } else if (want.length === 2) {
    var p = bfsPath(want[0], want[1]);
    setHighlight(p.length ? p : want, p.length
      ? 'shortest path ' + labelOf(want[0]) + ' -> ' + labelOf(want[1]) + ': ' + (p.length - 1) + ' hops'
      : 'no path found between the two nodes - endpoints only');
  } else { setHighlight(want, want.length + ' nodes lit from the URL fragment'); }
  var first = commOf(want[0]);
  if (first) openCommunity(D.communities.indexOf(first));
  return true;
}

function cut(s, n) { s = s || ''; return s.length > n ? s.slice(0, n - 1) + '…' : s; }
// paths keep their tail: the filename is what identifies them
function cutPath(s, n) { return s.length > n ? '…' + s.slice(1 - n) : s; }
function elt(tag, cls, text) {
  var e = document.createElement(tag);
  if (cls) e.className = cls;
  if (text !== undefined) e.textContent = text;
  return e;
}

function renderCards() {
  el.cards.textContent = '';
  D.communities.forEach(function (c, ci) {
    var b = elt('button', 'card');
    b.style.borderLeftColor = c.color;
    b.appendChild(elt('div', 'name', c.name));
    b.firstChild.title = c.name;
    var meta = elt('div', 'meta');
    meta.appendChild(elt('span', null, c.size + (c.size === 1 ? ' node' : ' nodes')));
    meta.appendChild(elt('span', null, 'in ' + c.fanin));
    meta.appendChild(elt('span', null, 'out ' + c.fanout));
    b.appendChild(meta);
    if (c.paths.length) {
      var p = elt('div', 'paths');
      c.paths.forEach(function (full) {
        var s = elt('span', null, cutPath(full, 36));
        s.title = full;
        p.appendChild(s);
      });
      b.appendChild(p);
    }
    b.onclick = function () { openCommunity(ci); };
    b.dataset.ci = ci;
    el.cards.appendChild(b);
  });
}

function openCommunity(ci) {
  state.open = ci;
  var c = D.communities[ci];
  el.stage.hidden = false;
  el.title.textContent = c.name + '  ·  ' + c.size + ' nodes, ' + c.iedges.length
    + ' internal edges, ' + c.neighbours.length + ' linked communities';
  drawCommunity(c);
  el.stage.scrollIntoView({ block: 'nearest' });
}

function drawCommunity(c) {
  var svg = el.view;
  svg.textContent = '';
  svg.setAttribute('viewBox', '0 0 ' + c.w + ' ' + c.h);
  var g = document.createElementNS(svg.namespaceURI, 'g');
  svg.appendChild(g);
  svg.__g = g;
  c.iedges.forEach(function (e) {
    var a = c.nodes[e[0]], b = c.nodes[e[1]];
    var p = document.createElementNS(svg.namespaceURI, 'path');
    var x1 = a.x + NODE_W, y1 = a.y + NODE_H / 2, x2 = b.x, y2 = b.y + NODE_H / 2;
    var mid = (x1 + x2) / 2;
    p.setAttribute('d', 'M' + x1 + ' ' + y1 + ' C' + mid + ' ' + y1 + ' ' + mid + ' ' + y2 + ' ' + x2 + ' ' + y2);
    p.setAttribute('class', 'e');
    p.dataset.a = a.id; p.dataset.b = b.id;
    var t = document.createElementNS(svg.namespaceURI, 'title');
    t.textContent = a.label + ' ' + e[2] + ' ' + b.label;
    p.appendChild(t);
    g.appendChild(p);
  });
  c.nodes.forEach(function (n) {
    var wrap = document.createElementNS(svg.namespaceURI, 'g');
    wrap.setAttribute('class', 'n' + (n.entry ? ' entry' : ''));
    wrap.setAttribute('transform', 'translate(' + n.x + ',' + n.y + ')');
    wrap.dataset.id = n.id;
    var r = document.createElementNS(svg.namespaceURI, 'rect');
    r.setAttribute('width', NODE_W); r.setAttribute('height', NODE_H);
    if (n.entry) r.style.stroke = c.color;   // inline style, so the .n rect rule cannot outrank it
    wrap.appendChild(r);
    var tx = document.createElementNS(svg.namespaceURI, 'text');
    tx.setAttribute('x', 8); tx.setAttribute('y', NODE_H / 2 + 4);
    tx.textContent = cut(n.label, LABEL_CHARS);
    wrap.appendChild(tx);
    var t = document.createElementNS(svg.namespaceURI, 'title');
    t.textContent = n.label + '\n' + (n.path || '(no path)') + '\nfan-in ' + n.fin + ' / fan-out ' + n.fout;
    wrap.appendChild(t);
    wrap.onclick = function (ev) { ev.stopPropagation(); inspect(n.id); };
    g.appendChild(wrap);
  });
  paint();
}

function paint() {
  var lit = state.highlight, any = Object.keys(lit).length > 0;
  Array.prototype.forEach.call(el.cards.children, function (card) {
    var c = D.communities[card.dataset.ci];
    var hit = any && c.nodes.some(function (n) { return lit[n.id]; });
    card.classList.toggle('dim', any && !hit);
    card.classList.toggle('lit', hit);
  });
  Array.prototype.forEach.call(el.view.querySelectorAll('.n'), function (g) {
    var on = !!lit[g.dataset.id];
    g.classList.toggle('lit', on);
    g.classList.toggle('dim', any && !on);
    g.classList.toggle('sel', g.dataset.id === state.sel);
  });
  Array.prototype.forEach.call(el.view.querySelectorAll('.e'), function (p) {
    var on = !!(lit[p.dataset.a] && lit[p.dataset.b]);
    p.classList.toggle('lit', on);
    p.classList.toggle('dim', any && !on);
  });
}

function inspect(id) {
  state.sel = id;
  var n = nodeOf(id), c = commOf(id);
  el.inspect.textContent = '';
  if (!n) { el.inspect.appendChild(elt('p', 'hint', 'unknown node ' + id)); return; }
  var dl = elt('dl', 'kv');
  [['label', n.label], ['id', n.id], ['path', (n.path || '(none)') + (n.loc ? ' ' + n.loc : '')],
   ['group', c.name], ['kind', n.kind || '(unknown)'],
   ['fan-in', String(n.fin)], ['fan-out', String(n.fout)]].forEach(function (kv) {
    dl.appendChild(elt('dt', null, kv[0]));
    dl.appendChild(elt('dd', null, kv[1]));
  });
  el.inspect.appendChild(dl);
  var cmd = elt('pre', 'cmd', '/graphify-wrapper-query ' + D.domain + ' --explain "' + n.q + '"');
  el.inspect.appendChild(cmd);
  var list = elt('ul', 'edges');
  (adjIn[id] || []).forEach(function (s) { list.appendChild(edgeRow('in', s)); });
  (adjOut[id] || []).forEach(function (t) { list.appendChild(edgeRow('out', t)); });
  if (!list.children.length) list.appendChild(elt('li', null, 'no edges'));
  el.inspect.appendChild(list);
  var blast = elt('button', 'ghost', 'light blast radius');
  blast.onclick = function () {
    var r = reach(adjIn, id);
    setHighlight(r, 'blast radius of ' + n.label + ': ' + (r.length - 1) + ' nodes reach it');
  };
  el.inspect.appendChild(blast);
  paint();
}

function edgeRow(dir, other) {
  var li = elt('li');
  li.appendChild(elt('span', 'rel', dir === 'in' ? '← ' : '→ '));
  var b = elt('button', null, labelOf(other));
  b.title = other;
  b.onclick = function () {
    var c = commOf(other);
    if (c) openCommunity(D.communities.indexOf(c));
    inspect(other);
  };
  li.appendChild(b);
  return li;
}

function renderFlows() {
  if (!el.flows) return;
  el.flows.textContent = '';
  D.flows.forEach(function (f, fi) {
    var b = elt('button', 'flow' + (f.found ? '' : ' none'));
    b.appendChild(elt('div', 'nm', f.name));
    b.appendChild(elt('div', 'st', f.found
      ? (f.steps.length - 1) + ' hops: ' + labelOf(f.from) + ' → ' + labelOf(f.to)
      : 'no path found: ' + labelOf(f.from) + ' → ' + labelOf(f.to)));
    b.onclick = function () { selectFlow(fi); };
    b.dataset.fi = fi;
    el.flows.appendChild(b);
  });
}

function selectFlow(fi) {
  var f = D.flows[fi];
  state.flow = state.flow === fi ? null : fi;
  Array.prototype.forEach.call(el.flows.children, function (b) {
    b.classList.toggle('on', String(state.flow) === b.dataset.fi);
  });
  el.steps.textContent = '';
  if (state.flow === null) { setHighlight([], ''); return; }
  if (!f.found) {
    el.steps.appendChild(elt('p', 'note', 'no path found from ' + labelOf(f.from) + ' to ' + labelOf(f.to) + ' - nothing invented.'));
    setHighlight([f.from, f.to], f.name + ': no path found');
    return;
  }
  var ol = elt('ol', 'steps');
  for (var i = 0; i < f.steps.length - 1; i++) {
    var li = elt('li');
    li.appendChild(elt('span', 'hop', String(i + 1)));
    var d = elt('div');
    var a = nodeOf(f.steps[i]), b = nodeOf(f.steps[i + 1]);
    var strong = elt('b', null, a.label);
    d.appendChild(strong);
    d.appendChild(document.createTextNode(' → '));
    d.appendChild(elt('b', null, b.label));
    var k = elt('div', 'k', (b.path || b.id));
    d.appendChild(k);
    li.appendChild(d);
    ol.appendChild(li);
  }
  el.steps.appendChild(ol);
  setHighlight(f.steps, f.name + ': ' + (f.steps.length - 1) + ' hops');
  var c = commOf(f.steps[0]);
  if (c) openCommunity(D.communities.indexOf(c));
}

// pan + zoom: one viewBox, no library
(function () {
  var svg = el.view, box = null, drag = null;
  function vb() { return svg.getAttribute('viewBox').split(' ').map(Number); }
  svg.addEventListener('wheel', function (ev) {
    ev.preventDefault();
    box = vb();
    var k = ev.deltaY > 0 ? 1.12 : 0.89;
    var r = svg.getBoundingClientRect();
    var mx = box[0] + (ev.clientX - r.left) / r.width * box[2];
    var my = box[1] + (ev.clientY - r.top) / r.height * box[3];
    svg.setAttribute('viewBox', [mx - (mx - box[0]) * k, my - (my - box[1]) * k,
      box[2] * k, box[3] * k].join(' '));
  }, { passive: false });
  svg.addEventListener('mousedown', function (ev) {
    drag = { x: ev.clientX, y: ev.clientY, box: vb() };
    svg.classList.add('drag');
  });
  window.addEventListener('mouseup', function () { drag = null; svg.classList.remove('drag'); });
  window.addEventListener('mousemove', function (ev) {
    if (!drag) return;
    var r = svg.getBoundingClientRect();
    svg.setAttribute('viewBox', [
      drag.box[0] - (ev.clientX - drag.x) / r.width * drag.box[2],
      drag.box[1] - (ev.clientY - drag.y) / r.height * drag.box[3],
      drag.box[2], drag.box[3]].join(' '));
  });
}());

document.getElementById('close').onclick = function () {
  el.stage.hidden = true; state.open = null;
};
document.getElementById('clear').onclick = function () {
  state.flow = null;
  if (el.flows) Array.prototype.forEach.call(el.flows.children, function (b) { b.classList.remove('on'); });
  el.steps.textContent = '';
  setHighlight([], '');
};
window.addEventListener('hashchange', fragmentHighlight);

renderCards();
renderFlows();
if (!fragmentHighlight() && D.highlight.length) {
  setHighlight(D.highlight, D.highlight_note);
  var c0 = commOf(D.highlight[0]);
  if (c0) openCommunity(D.communities.indexOf(c0));
}
"""


def esc(text):
    return html.escape(str(text), quote=True)


def render_page(data):
    counts = data["counts"]
    if data["flows"]:
        flows_panel = (
            '<section class="panel"><h2>Flows</h2><div class="body">'
            '<div id="flows"></div><div id="steps"></div>'
            '<p class="hint">Steps are a shortest path over the embedded graph, '
            'recomputed at generation time - never authored.</p>'
            '</div></section>'
        )
    else:
        flows_panel = (
            '<section class="panel"><h2>Flows</h2><div class="body">'
            '<p class="hint">No flows.json beside the graph. Declare named endpoint pairs as '
            '<code>[{"name","from","to"}]</code> and the steps get computed here.</p>'
            '<div id="flows" hidden></div><div id="steps" hidden></div>'
            '</div></section>'
        )
    top_strip = ""
    if data["top_nodes"]:
        chips = " ".join(
            '<span class="badge" title="%s">%s &middot; in %d</span>'
            % (esc(n["id"]), esc(n["label"]), n["fin"]) for n in data["top_nodes"])
        top_strip = ('<div class="bar"><span class="hint">most depended on</span>%s</div>'
                     % chips)
    guard_note = ""
    if data["aggregated"]:
        # Says only what the guard actually changes. The drill-down is per-community at every size
        # (there is no whole-graph SVG to thin out), so the one whole-graph surface is this strip.
        guard_note = ('<div class="bar"><span class="note">%d nodes is above the %d-node guard, '
                      'so the whole-graph "most depended on" strip is dropped; drill into a '
                      'community for its nodes.</span></div>'
                      % (counts["nodes"], data["guard"]))

    return "".join([
        '<meta charset="utf-8">',
        '<meta name="viewport" content="width=device-width, initial-scale=1">',
        "<title>%s atlas</title>" % esc(data["domain"]),
        "<style>", CSS, "</style>",
        '<script id="atlas-data" type="application/json">', embed_json(data), "</script>",
        "<header>",
        '<h1>%s <span class="sub">codebase atlas</span></h1>' % esc(data["domain"]),
        '<div class="stamps">',
        "<span><b>%d</b> nodes</span>" % counts["nodes"],
        "<span><b>%d</b> edges</span>" % counts["edges"],
        "<span><b>%d</b> communities</span>" % counts["communities"],
        "<span>built at <code>%s</code></span>" % esc(data["built_at_commit"]),
        "<span>generated %s</span>" % esc(data["generated_at"]),
        "</div></header>",
        "<main><div>",
        '<section class="panel">',
        '<h2>Communities <span class="badge">fan-in ranked</span></h2>',
        guard_note, top_strip,
        '<div class="cards" id="cards"></div>',
        "</section>",
        '<section class="panel" id="stage" hidden style="margin-top:14px">',
        '<div class="bar"><b id="stage-title"></b><span class="grow"></span>',
        '<span class="hint">drag to pan, scroll to zoom, click a node to inspect</span>',
        '<button class="ghost" id="close">close</button></div>',
        '<svg id="view" role="img" aria-label="community sub-view"></svg>',
        "</section>",
        "</div>",
        '<div class="side">',
        '<section class="panel"><h2>Highlight</h2><div class="body">',
        '<p class="hint" id="note">%s</p>' % esc(data["highlight_note"]),
        '<button class="ghost" id="clear">clear highlight</button>',
        '<p class="hint">URL fragment: <code>#highlight=id</code> (blast radius) or '
        '<code>#highlight=idA,idB</code> (path).</p>',
        "</div></section>",
        flows_panel,
        '<section class="panel"><h2>Inspector</h2><div class="body" id="inspect">',
        '<p class="hint">Click a node in an expanded community.</p>',
        "</div></section>",
        "</div></main>",
        "<footer><span>regenerate: <code>bd-atlas %s</code></span>"
        % esc(data.get("_graph_arg", "<graph.json>")),
        "<span>a pure function of graph.json - no history, no network</span></footer>",
        "<script>var NODE_W=%d,NODE_H=%d,LABEL_CHARS=%d;" % (NODE_W, NODE_H, LABEL_CHARS),
        'window.ATLAS_DATA=JSON.parse(document.getElementById("atlas-data").textContent);',
        JS, "</script>",
    ])


def generate(graph_path, flows_path=None, highlight=None, out_path=None):
    """Build the page for graph_path and write it. Returns the written path."""
    graph_path = os.path.abspath(graph_path)
    graph = load_graph(graph_path)
    parent = os.path.dirname(graph_path)
    domain = os.path.basename(parent) or "graph"
    if flows_path is None:
        maybe = os.path.join(parent, "flows.json")
        flows_path = maybe if os.path.exists(maybe) else None
    data = build_data(graph, domain, flows_path, highlight)
    data["_graph_arg"] = graph_path
    out = out_path or os.path.join(parent, "%s-atlas.html" % domain)
    page = render_page(data)
    verify_page(page, data)
    try:
        with open(out, "w", encoding="utf-8") as fh:
            fh.write(page)
    except OSError as exc:
        die("cannot write %s (%s)" % (out, exc))
    return out, data


# Every way a page can ask the network for something: an attribute (either quote style), a CSS
# url(), or an @import. Narrower than this and the check backs a claim it does not cover.
REMOTE_REF = re.compile(
    r"""(?:src|href)\s*=\s*['"](?!\#)(?:[a-zA-Z][a-zA-Z0-9+.\-]*:)?//"""
    r"""|(?:src|href)\s*=\s*['"]https?:"""
    r"""|url\(\s*['"]?(?:[a-zA-Z][a-zA-Z0-9+.\-]*:)?//"""
    r"""|url\(\s*['"]?https?:"""
    r"""|@import""")


def verify_page(page, data):
    """Offline + embed checks on the rendered bytes, before anything hits disk (R2, R13b)."""
    m = re.search(r'<script id="atlas-data" type="application/json">(.*?)</script>',
                  page, re.S)
    if not m:
        die("rendered page has no atlas-data block")
    try:
        parsed = json.loads(m.group(1))
    except json.JSONDecodeError as exc:
        die("embedded atlas-data is not valid JSON (%s)" % exc)
    if parsed["counts"] != data["counts"]:
        die("embedded counts do not match the computed ones")
    if "window.ATLAS_DATA" not in page:
        die("rendered page does not mirror the data to window.ATLAS_DATA")
    hit = REMOTE_REF.search(page)
    if hit:
        die("rendered page references a remote resource: %s" % hit.group(0))
    # An absolute URL in the stylesheet or the script is a fetch waiting to happen, so the
    # network-off claim gets checked at generation time and not only in the selftest. Scoped to the
    # two static chunks on purpose: a node label or a domain name is data the graph is allowed to
    # carry and data fetches nothing, while a fetchable reference anywhere in the page - either
    # quote style, a CSS url(), an @import - is what REMOTE_REF above already refuses.
    for chunk, what in ((CSS, "stylesheet"), (JS, "script")):
        if "http://" in chunk or "https://" in chunk:
            die("the %s carries an absolute URL - the page must open with the network off" % what)


# ---------------------------------------------------------------- selftest

# One hostile node in the fixture, so the gate exercises embed_json's escaping - the script's only
# injection path - instead of asserting "</script> not in blob" over data with no `<` in it at all.
HOSTILE_ID = 'hostile</script><b id="x">'
HOSTILE_LABEL = '</script><img src=x onerror=alert(1)> & "quoted" \'single\''
HOSTILE_DIR = '</script>&"\'<dir>'

SYNTH_NODES = [
    # community 0: a small pipeline, cli -> parse -> plan -> emit
    ("cli", "cli.py", 0, "cli"),
    ("parse", "parse.py", 0, "parse_args"),
    ("plan", "plan.py", 0, "make_plan"),
    ("emit", "emit.py", 0, "emit"),
    # community 1: shared helpers the pipeline calls
    ("util_log", "util/log.py", 1, "log"),
    ("util_fs", "util/fs.py", 1, "write_file"),
    # community 2: an island nothing in 0/1 reaches
    ("island_a", "island/a.py", 2, "island_entry"),
    ("island_b", "island/b.py", 2, "island_leaf"),
    # community 3: markup in the id, the label and (via its first path segment) the community name
    (HOSTILE_ID, HOSTILE_DIR + "/x.py", 3, HOSTILE_LABEL),
]
SYNTH_EDGES = [("cli", "parse", "calls"), ("parse", "plan", "calls"),
               ("plan", "emit", "calls"), ("plan", "util_log", "calls"),
               ("emit", "util_fs", "calls"), ("island_a", "island_b", "calls")]


def write_synth(dirpath):
    nodes = [{"id": nid, "label": label, "source_file": path, "source_location": "L1",
              "community": comm, "community_name": path.split("/")[0],
              "metadata": {"kind": "function"}}
             for nid, path, comm, label in SYNTH_NODES]
    graph = {"directed": True, "nodes": nodes,
             "links": [{"source": s, "target": t, "relation": r} for s, t, r in SYNTH_EDGES],
             "built_at_commit": "deadbee"}
    os.makedirs(dirpath, exist_ok=True)
    gpath = os.path.join(dirpath, "graph.json")
    with open(gpath, "w", encoding="utf-8") as fh:
        json.dump(graph, fh)
    fpath = os.path.join(dirpath, "flows.json")
    with open(fpath, "w", encoding="utf-8") as fh:
        json.dump([{"name": "cli to output", "from": "cli", "to": "util_fs"},
                   {"name": "cli to island", "from": "cli", "to": "island_b"}], fh)
    return gpath, fpath


def selftest():
    global SIZE_GUARD
    with tempfile.TemporaryDirectory(prefix="bd-atlas-selftest-") as tmp:
        domain_dir = os.path.join(tmp, "widgets")
        gpath, fpath = write_synth(domain_dir)

        out, data = generate(gpath)
        assert out == os.path.join(domain_dir, "widgets-atlas.html"), out
        assert os.path.exists(out), "page not written"
        page = open(out, encoding="utf-8").read()

        # a. data embedded once, valid JSON, mirrored to window.ATLAS_DATA
        blob = re.search(r'<script id="atlas-data" type="application/json">(.*?)</script>',
                         page, re.S).group(1)
        embedded = json.loads(blob)
        assert embedded["counts"] == {"nodes": 9, "edges": 6, "communities": 4}, embedded["counts"]
        assert "window.ATLAS_DATA" in page
        assert "</script>" not in blob, "embedded blob can break out of its script element"

        # a-hostile. the fixture's markup-carrying node: nothing raw survives into the blob, the
        # label still round-trips through json.loads, and no live tag reaches the page
        for raw in ("<", ">", "&"):
            assert raw not in blob, "raw %r survived embed_json" % raw
        hostile = [n for c in embedded["communities"] for n in c["nodes"]
                   if n["id"] == HOSTILE_ID]
        assert len(hostile) == 1, [n["id"] for c in embedded["communities"] for n in c["nodes"]]
        assert hostile[0]["label"] == HOSTILE_LABEL, hostile[0]["label"]
        assert "<img src=x" not in page, "hostile label reached the page as live markup"
        assert "hostile</script>" not in page, "hostile id reached the page as live markup"

        # offline: no remote src/href anywhere in the page
        assert not REMOTE_REF.search(page), "page references a remote resource"
        assert "http://" not in page and "https://" not in page, "page carries an absolute URL"

        # b. layout computed here: every node has a position, entry points sit in column one
        pipeline = [c for c in embedded["communities"] if c["name"] == "cli.py"]
        assert len(pipeline) == 1, [c["name"] for c in embedded["communities"]]
        pos = {n["label"]: (n["x"], n["y"]) for n in pipeline[0]["nodes"]}
        assert pos["cli"][0] == PAD, pos
        assert pos["parse_args"][0] > pos["cli"][0], pos
        assert pos["make_plan"][0] > pos["parse_args"][0], pos
        assert pipeline[0]["nodes"][0]["label"] == "cli", "entry point is not first"
        # the community-aggregated graph rides along, so an over-guard page still has structure
        assert pipeline[0]["neighbours"], "community-level links missing"

        # c. header stamps + footer command
        assert "deadbee" in page and "regenerate: <code>" in page
        assert embedded["built_at_commit"] == "deadbee"

        # d. inspector emits the next command
        assert "/graphify-wrapper-query ' + D.domain + ' --explain" in page

        # e. flows: computed steps, and an honest refusal when no path exists
        out2, data2 = generate(gpath, flows_path=fpath)
        flows = {f["name"]: f for f in data2["flows"]}
        assert flows["cli to output"]["steps"] == ["cli", "parse", "plan", "emit", "util_fs"], flows
        assert flows["cli to island"]["found"] is False, flows["cli to island"]
        assert flows["cli to island"]["steps"] == [], "a missing path must render no steps"
        # the check refuses a step that is not in the graph at all
        bogus = dict(data2)
        bogus["flows"] = [{"name": "fake", "from": "cli", "to": "ghost",
                           "steps": ["cli", "ghost"], "found": True}]
        try:
            check_data(bogus, load_graph(gpath))
            raise AssertionError("check_data accepted a step that is not in the graph")
        except AtlasError as exc:
            assert "fake" in str(exc) and "ghost" in str(exc), exc
        # and the one trap 145 actually describes: real ids, the right endpoints, steps no edge
        # connects - what a model authoring a plausible path produces. Id existence cannot see it.
        for steps, hop in ((["cli", "island_a", "util_fs"], "island_a"),
                           (["cli", "parse", "util_log", "plan", "emit", "util_fs"], "util_log")):
            invented = dict(data2)
            invented["flows"] = [{"name": "invented", "from": "cli", "to": "util_fs",
                                  "steps": steps, "found": True}]
            try:
                check_data(invented, load_graph(gpath))
                raise AssertionError("check_data accepted a fabricated path of real ids: %s" % steps)
            except AtlasError as exc:
                assert "invented" in str(exc) and hop in str(exc), exc

        # f. highlight: path, blast radius, substring match, refusals
        _o, dpath = generate(gpath, highlight="cli,util_fs")
        assert dpath["highlight"] == ["cli", "parse", "plan", "emit", "util_fs"], dpath["highlight"]
        _o, dblast = generate(gpath, highlight="write_file")     # unique label substring
        assert dblast["highlight"] == ["cli", "emit", "parse", "plan", "util_fs"], dblast["highlight"]
        graph = load_graph(gpath)
        by_id = {n["id"]: n for n in graph["nodes"]}
        assert resolve_name(graph["nodes"], by_id, "island_leaf") == "island_b"
        for bad, needle in (("island", "matches"), ("nope", "no node matches")):
            try:
                resolve_name(graph["nodes"], by_id, bad)
                raise AssertionError("resolve_name accepted %r" % bad)
            except AtlasError as exc:
                assert needle in str(exc), exc
        no_path = generate(gpath, highlight="cli,island_leaf")[1]
        assert no_path["highlight"] == ["cli", "island_b"], no_path["highlight"]
        assert "no path" in no_path["highlight_note"]

        # g. size guard: flip the threshold and the overview drops per-node content
        assert data["aggregated"] is False and data["top_nodes"], "guard misfired on 8 nodes"
        SIZE_GUARD = 2
        try:
            guarded = generate(gpath, out_path=os.path.join(tmp, "guarded.html"))[1]
            assert guarded["aggregated"] is True
            assert guarded["top_nodes"] == [], "guarded overview still embeds per-node content"
            assert sum(len(c["nodes"]) for c in guarded["communities"]) == 9, "guard lost nodes"
        finally:
            SIZE_GUARD = 3000

        # refusals on bad input
        for payload, needle in (("{}", "no nodes"), ('{"nodes":[{}]}', "no id"),
                                ("not json", "not valid JSON")):
            bad_path = os.path.join(tmp, "bad.json")
            with open(bad_path, "w", encoding="utf-8") as fh:
                fh.write(payload)
            try:
                load_graph(bad_path)
                raise AssertionError("load_graph accepted %r" % payload)
            except AtlasError as exc:
                assert needle in str(exc), exc
        assert load_graph(gpath)["edges"], "links key not read"

        # `edges` key compat
        alt = json.load(open(gpath, encoding="utf-8"))
        alt["edges"] = alt.pop("links")
        alt_path = os.path.join(tmp, "alt.json")
        with open(alt_path, "w", encoding="utf-8") as fh:
            json.dump(alt, fh)
        assert len(load_graph(alt_path)["edges"]) == 6, "edges key not accepted"

        # a graph with no community/commit attributes still renders
        plain = {"nodes": [{"id": "a", "source_file": "src/a.py"},
                           {"id": "b", "source_file": "src/b.py"}],
                 "links": [{"source": "a", "target": "b"}]}
        plain_dir = os.path.join(tmp, "plain")
        os.makedirs(plain_dir)
        plain_path = os.path.join(plain_dir, "graph.json")
        with open(plain_path, "w", encoding="utf-8") as fh:
            json.dump(plain, fh)
        _o, pdata = generate(plain_path)
        assert pdata["built_at_commit"] == "unknown"
        assert pdata["counts"] == {"nodes": 2, "edges": 1, "communities": 1}, pdata["counts"]

        # palette stays inside the safe hues and never repeats within a cycle
        pal = palette(40)
        assert len(set(pal[:8])) == 8 and len(set(pal)) >= 32, pal
    print("selftest OK")
    return 0


# ---------------------------------------------------------------- cli

USAGE = """bd-atlas - render a codebase atlas from a graphify graph.json

  bd-atlas <graph.json> [--flows <flows.json>] [--highlight "A[,B]"] [--out <page.html>]
  bd-atlas selftest

  --flows      [{name, from, to}] pairs; steps are computed here, never authored
  --highlight  one node = blast radius (everything that reaches it), two = shortest path
  --out        default: <domain>-atlas.html beside graph.json
"""


def parse_argv(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print(USAGE, end="")
        raise SystemExit(0)
    graph = None
    opts = {"flows": None, "highlight": None, "out": None}
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("--flows", "--highlight", "--out"):
            if i + 1 >= len(argv):
                die("%s needs a value" % arg)
            opts[arg[2:]] = argv[i + 1]
            i += 2
            continue
        if arg.startswith("-"):
            die("unknown option %s\n\n%s" % (arg, USAGE))
        if graph is not None:
            die("one graph.json at a time (got %s and %s)" % (graph, arg))
        graph = arg
        i += 1
    if graph is None:
        die("no graph.json given\n\n%s" % USAGE)
    return graph, opts


def main(argv):
    if argv[:1] == ["selftest"]:
        if len(argv) > 1:
            die("selftest takes no arguments")
        return selftest()
    graph, opts = parse_argv(argv)
    out, data = generate(graph, opts["flows"], opts["highlight"], opts["out"])
    counts = data["counts"]
    print("%s  (%d nodes, %d edges, %d communities, built at %s)"
          % (out, counts["nodes"], counts["edges"], counts["communities"],
             data["built_at_commit"]))
    for flow in data["flows"]:
        print("  flow %-28s %s" % (
            flow["name"],
            "%d hops" % (len(flow["steps"]) - 1) if flow["found"] else "no path found"))
    if data["highlight"]:
        print("  highlight: %s" % data["highlight_note"])
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except AtlasError as err:
        sys.stderr.write("bd-atlas: %s\n" % err)
        sys.exit(1)
    except (BrokenPipeError, KeyboardInterrupt):
        sys.exit(130)
