#!/usr/bin/env python3
# bd-atlas - better-dev's codebase atlas: one offline HTML page computed from a graphify graph.json.
#
#   bd-atlas <graph.json> [--flows flows.json] [--highlight "A[,B]"] [--out page.html]
#   bd-atlas selftest                       run the built-in checks and exit
#
# The atlas is a pure function of graph.json (+ optional flows.json) - delete the page and rebuild
# it losslessly. It holds no run history, makes no network call, and vendors no JS library: the
# layout is computed here in Python, the page ships SVG plus a little vanilla JS for
# pan/zoom/expand/inspect. Regenerate it after `graphify update`; never commit the rendered page.
#
# This is the CODE side of the two-surface firewall in skills/orchestrating-agents/observatory.md:
# a fact about the run belongs on the run observatory's record, a fact about the code is recomputed
# from the graph here, and neither surface borrows the other's name or store.
#
# Data contract: everything the page draws is embedded once in
# <script id="atlas-data" type="application/json"> and mirrored to window.ATLAS_DATA, so an agent
# or a console can read the same numbers the pixels came from.
#
# Flows are computed, never invented: flows.json declares [{name, from, to}] and the steps are a
# BFS shortest path over the embedded graph at generation time. Every rendered step is checked
# against the graph's own edges - each consecutive pair has to be a real edge - before the page is
# written; a step that is not is a generator bug or hand-injected data, and exits non-zero.
#
# Stdlib only, no network, no pip deps.

import colorsys
import html
import json
import os
import re
import sys
import tempfile
from collections import deque
from datetime import datetime, timezone

SIZE_GUARD = 3000       # above this many nodes the overview stays aggregated (R13h)
MAX_CANDIDATES = 12     # how many candidates a refusal lists
LABEL_CHARS = 22        # SVG label truncation; the full text rides a <title>


class AtlasError(Exception):
    """A refusal the operator can act on - printed as `bd-atlas: <message>`."""


def die(msg):
    raise AtlasError(msg)


# ---------------------------------------------------------------- graph loading

def load_graph(path):
    """Read a graphify node-link graph.json. Edges live under `links`; `edges` accepted."""
    try:
        with open(path, encoding="utf-8") as fh:
            raw = json.load(fh)
    except FileNotFoundError:
        die("no such graph: %s" % path)
    except OSError as exc:
        # a directory, a permission denial, a dead symlink - all operator-fixable, so they
        # get the `bd-atlas: <message>` channel rather than a traceback
        die("cannot read %s (%s)" % (path, exc))
    except json.JSONDecodeError as exc:
        die("%s is not valid JSON (%s)" % (path, exc))
    if not isinstance(raw, dict):
        die("%s is not a node-link graph object" % path)
    nodes = raw.get("nodes")
    if not isinstance(nodes, list) or not nodes:
        die("%s has no nodes" % path)
    links = raw.get("links")
    if links is None:
        links = raw.get("edges")
    if links is None:
        links = []
    if not isinstance(links, list):
        die("%s: links/edges is not a list" % path)

    clean = []
    seen = set()
    for i, node in enumerate(nodes):
        if not isinstance(node, dict):
            die("%s: node %d is not an object" % (path, i))
        nid = node.get("id")
        if nid is None:
            die("%s: node %d has no id" % (path, i))
        nid = str(nid)
        if nid in seen:
            continue                      # graphify never emits dupes; last one loses if it does
        seen.add(nid)
        clean.append(dict(node, id=nid))

    edges = []
    for link in links:
        if not isinstance(link, dict):
            continue
        src, dst = link.get("source"), link.get("target")
        if src is None or dst is None:
            continue
        src, dst = str(src), str(dst)
        if src not in seen or dst not in seen:
            continue                      # dangling endpoint: nothing to draw it against
        edges.append((src, dst, str(link.get("relation") or link.get("type") or "edge")))

    return {
        "nodes": clean,
        "edges": edges,
        "built_at_commit": str(raw.get("built_at_commit") or "unknown"),
    }


def node_path(node):
    for key in ("source_file", "file", "path", "filepath", "file_path"):
        val = node.get(key)
        if val:
            return str(val)
    return ""


def node_label(node):
    for key in ("label", "name", "norm_label"):
        val = node.get(key)
        if val:
            return str(val)
    return node["id"]


def community_of(node):
    val = node.get("community")
    if val is None:
        val = node.get("group")
    if val is None:
        # No community attribute: fall back to the top directory of the node's path, which is the
        # grouping graphify's communities approximate anyway.
        p = node_path(node)
        return p.split("/")[0] if p else "ungrouped"
    return val


# ---------------------------------------------------------------- name matching

def resolve_name(nodes, by_id, name):
    """Exact id, else a unique substring match on id/label. Ambiguity refuses with candidates."""
    name = name.strip()
    if not name:
        die("empty node name")
    if name in by_id:
        return name
    low = name.lower()
    cands = [n for n in nodes if low in n["id"].lower() or low in node_label(n).lower()]
    exact = [n for n in cands if node_label(n).lower() == low]
    if len(exact) == 1:
        return exact[0]["id"]
    if len(cands) == 1:
        return cands[0]["id"]
    if not cands:
        die('no node matches "%s"' % name)
    listing = "\n".join(
        "  %s  (%s)" % (n["id"], node_label(n)) for n in cands[:MAX_CANDIDATES]
    )
    more = "" if len(cands) <= MAX_CANDIDATES else "\n  ... and %d more" % (
        len(cands) - MAX_CANDIDATES)
    die('"%s" matches %d nodes - name one:\n%s%s' % (name, len(cands), listing, more))


# ---------------------------------------------------------------- graph walking

def adjacency(nodes, edges):
    out = {n["id"]: [] for n in nodes}
    inn = {n["id"]: [] for n in nodes}
    for src, dst, rel in edges:
        out[src].append((dst, rel))
        inn[dst].append((src, rel))
    return out, inn


def shortest_path(out, start, goal):
    """BFS over the directed graph. Returns the node-id path, or [] when none exists."""
    if start == goal:
        return [start]
    prev = {start: None}
    queue = deque([start])
    while queue:
        cur = queue.popleft()
        for nxt, _rel in out.get(cur, ()):
            if nxt in prev:
                continue
            prev[nxt] = cur
            if nxt == goal:
                path = [nxt]
                while prev[path[-1]] is not None:
                    path.append(prev[path[-1]])
                return list(reversed(path))
            queue.append(nxt)
    return []


def reachable(adj, start):
    """Every node reachable from start over adj (pass the reverse index for a blast radius)."""
    seen = {start}
    queue = deque([start])
    while queue:
        cur = queue.popleft()
        for nxt, _rel in adj.get(cur, ()):
            if nxt not in seen:
                seen.add(nxt)
                queue.append(nxt)
    return seen


# ---------------------------------------------------------------- palette (R13h)

# Okabe-Ito: eight hues that stay distinguishable under the common colour-vision deficiencies.
OKABE_ITO = ["#56b4e9", "#e69f00", "#009e73", "#f0e442",
             "#cc79a7", "#0072b2", "#d55e00", "#94d0c0"]
LIGHTNESS = [1.0, 0.78, 1.16, 0.62, 1.32]


def palette(count):
    """Deterministic accent per community: cycle the safe hues, then shift lightness."""
    colors = []
    for i in range(max(count, 1)):
        base = OKABE_ITO[i % len(OKABE_ITO)]
        factor = LIGHTNESS[(i // len(OKABE_ITO)) % len(LIGHTNESS)]
        r, g, b = (int(base[j:j + 2], 16) / 255.0 for j in (1, 3, 5))
        h, l, s = colorsys.rgb_to_hls(r, g, b)
        l = min(0.88, max(0.24, l * factor))
        r, g, b = colorsys.hls_to_rgb(h, l, s)
        colors.append("#%02x%02x%02x" % (round(r * 255), round(g * 255), round(b * 255)))
    return colors


# ---------------------------------------------------------------- layout

NODE_W, NODE_H, COL_W, ROW_H, PAD = 176, 26, 232, 40, 24


def layer_nodes(ids, internal_out, internal_in, fanin):
    """Layered order: entry-point-ish nodes (nothing inside calls them) first, then BFS depth.

    Within a layer, fan-in rank decides the order - the R8 sort order, no narration.
    """
    entries = [i for i in ids if not internal_in.get(i)]
    if not entries:                       # a cycle with no entry: start at the most-depended-on
        entries = sorted(ids, key=lambda i: (-fanin.get(i, 0), i))[:1]
    layer = {i: 0 for i in entries}
    queue = deque(entries)
    while queue:                          # plain BFS depth: terminates on cycles, no relaxation
        cur = queue.popleft()
        for nxt in internal_out.get(cur, ()):
            if nxt not in layer:
                layer[nxt] = layer[cur] + 1
                queue.append(nxt)
    deepest = max(layer.values()) if layer else 0
    for i in ids:                         # unreachable from any entry: park them after the rest
        layer.setdefault(i, deepest + 1)
    return layer


def build_community(cid, name, member_ids, ctx, color):
    """One community's card facts plus its precomputed sub-view positions."""
    node_by_id, out, inn = ctx["by_id"], ctx["out"], ctx["inn"]
    fanin, fanout, comm_by_id = ctx["fanin"], ctx["fanout"], ctx["comm_by_id"]
    members = set(member_ids)

    internal_out, internal_in = {}, {}
    for i in member_ids:
        internal_out[i] = [d for d, _r in out.get(i, ()) if d in members]
        internal_in[i] = [s for s, _r in inn.get(i, ()) if s in members]

    layer = layer_nodes(member_ids, internal_out, internal_in, fanin)
    ordered = sorted(member_ids, key=lambda i: (layer[i], -fanin.get(i, 0),
                                                -fanout.get(i, 0), node_label(node_by_id[i])))

    rows = {}
    positions = {}
    for i in ordered:
        col = layer[i]
        row = rows.get(col, 0)
        rows[col] = row + 1
        positions[i] = (PAD + col * COL_W, PAD + row * ROW_H)

    label_counts = ctx["label_counts"]
    nodes_out = []
    local_index = {}
    for i in ordered:
        node = node_by_id[i]
        lbl = node_label(node)
        x, y = positions[i]
        local_index[i] = len(nodes_out)
        nodes_out.append({
            "id": i,
            "label": lbl,
            "path": node_path(node),
            "loc": str(node.get("source_location") or ""),
            "kind": str((node.get("metadata") or {}).get("kind") or node.get("type") or ""),
            "fin": fanin.get(i, 0),
            "fout": fanout.get(i, 0),
            "entry": not internal_in.get(i),
            "q": lbl if label_counts.get(lbl, 0) == 1 else i,
            "x": x, "y": y,
        })

    iedges, xedges = [], []
    for i in member_ids:
        for dst, rel in out.get(i, ()):
            if dst in members:
                iedges.append([local_index[i], local_index[dst], rel])
            else:
                xedges.append([local_index[i], dst, rel, "out"])
        for src, rel in inn.get(i, ()):
            if src not in members:
                xedges.append([local_index[i], src, rel, "in"])

    neighbours = {}
    for local_i, far, _rel, _dir in xedges:
        neighbours[comm_by_id[far]] = neighbours.get(comm_by_id[far], 0) + 1

    paths = {}
    for i in member_ids:
        p = node_path(node_by_id[i])
        if p:
            paths[p] = paths.get(p, 0) + 1
    top_paths = [p for p, _c in sorted(paths.items(), key=lambda kv: (-kv[1], kv[0]))[:3]]

    width = PAD * 2 + (max(layer.values()) + 1) * COL_W - (COL_W - NODE_W)
    height = PAD * 2 + max(rows.values()) * ROW_H - (ROW_H - NODE_H)
    return {
        "cid": str(cid),
        "name": name,
        "size": len(member_ids),
        "color": color,
        "paths": top_paths,
        "fanin": sum(1 for e in xedges if e[3] == "in"),
        "fanout": sum(1 for e in xedges if e[3] == "out"),
        "nodes": nodes_out,
        "iedges": iedges,
        "xedges": xedges,
        "neighbours": sorted(([str(k), v] for k, v in neighbours.items()),
                             key=lambda kv: -kv[1])[:6],
        "w": width, "h": height,
    }


# ---------------------------------------------------------------- flows (R6)

def load_flows(path):
    if path is None:
        return []
    try:
        with open(path, encoding="utf-8") as fh:
            raw = json.load(fh)
    except FileNotFoundError:
        die("no such flows file: %s" % path)
    except json.JSONDecodeError as exc:
        die("%s is not valid JSON (%s)" % (path, exc))
    if not isinstance(raw, list):
        die("%s must be a list of {name, from, to}" % path)
    flows = []
    for i, entry in enumerate(raw):
        if not isinstance(entry, dict):
            die("%s: entry %d is not an object" % (path, i))
        for key in ("name", "from", "to"):
            if not entry.get(key):
                die("%s: entry %d has no %s" % (path, i, key))
        flows.append({"name": str(entry["name"]),
                      "from": str(entry["from"]), "to": str(entry["to"])})
    return flows


def compute_flows(flows, nodes, by_id, out):
    """Resolve endpoints, BFS the steps, and check every step against the graph (R6)."""
    computed = []
    for flow in flows:
        try:
            src = resolve_name(nodes, by_id, flow["from"])
            dst = resolve_name(nodes, by_id, flow["to"])
        except AtlasError as exc:
            die('flow "%s": %s' % (flow["name"], exc))
        steps = shortest_path(out, src, dst)
        resolved = [s for s in steps if s in by_id]
        if len(resolved) != len(steps):
            die('flow "%s": %d steps rendered but %d resolve in the graph - generator bug'
                % (flow["name"], len(steps), len(resolved)))
        computed.append({"name": flow["name"], "from": src, "to": dst,
                         "steps": steps, "found": bool(steps)})
    return computed


# ---------------------------------------------------------------- page assembly

def build_data(graph, domain, flows_path, highlight_arg):
    nodes, edges = graph["nodes"], graph["edges"]
    by_id = {n["id"]: n for n in nodes}
    out, inn = adjacency(nodes, edges)
    fanin = {i: len(v) for i, v in inn.items()}
    fanout = {i: len(v) for i, v in out.items()}

    label_counts = {}
    for n in nodes:
        lbl = node_label(n)
        label_counts[lbl] = label_counts.get(lbl, 0) + 1

    groups = {}
    names = {}
    for n in nodes:
        cid = community_of(n)
        groups.setdefault(cid, []).append(n["id"])
        names.setdefault(cid, str(n.get("community_name") or n.get("group_name") or ""))
    comm_by_id = {i: cid for cid, ids in groups.items() for i in ids}

    order = sorted(groups, key=lambda c: (-len(groups[c]), str(c)))
    colors = palette(len(order))
    ctx = {"by_id": by_id, "out": out, "inn": inn, "fanin": fanin, "fanout": fanout,
           "comm_by_id": comm_by_id, "label_counts": label_counts}

    communities = []
    for pos, cid in enumerate(order):
        name = names.get(cid) or "community %s" % cid
        communities.append(build_community(cid, name, groups[cid], ctx, colors[pos]))
    # Cards read fan-in first (who depends on this community), size second.
    communities.sort(key=lambda c: (-c["fanin"], -c["size"], c["name"]))

    flows = compute_flows(load_flows(flows_path), nodes, by_id, out)
    highlight, highlight_note = compute_highlight(highlight_arg, nodes, by_id, out, inn)

    aggregated = len(nodes) > SIZE_GUARD
    top_nodes = []
    if not aggregated:
        # A whole-graph strip is per-node content, so the size guard drops it (R13h); the
        # per-community sub-views carry only their own data either way.
        ranked = sorted(nodes, key=lambda n: (-fanin.get(n["id"], 0), node_label(n)))[:12]
        top_nodes = [{"id": n["id"], "label": node_label(n),
                      "fin": fanin.get(n["id"], 0)} for n in ranked]

    data = {
        "domain": domain,
        "built_at_commit": graph["built_at_commit"],
        "generated_at": datetime.now(timezone.utc).strftime("%Y-%m-%d %H:%M:%S UTC"),
        "counts": {"nodes": len(nodes), "edges": len(edges), "communities": len(order)},
        "aggregated": aggregated,
        "guard": SIZE_GUARD,
        "communities": communities,
        "flows": flows,
        "highlight": list(highlight),     # path order survives; a blast radius arrives sorted
        "highlight_note": highlight_note,
        "top_nodes": top_nodes,
    }
    check_data(data, graph)
    return data


def compute_highlight(arg, nodes, by_id, out, inn):
    if not arg:
        return [], ""
    wanted = [part for part in arg.split(",") if part.strip()]
    if not wanted:
        die("--highlight needs a node name")
    if len(wanted) > 2:
        die("--highlight takes one node (blast radius) or two (path); got %d" % len(wanted))
    ids = [resolve_name(nodes, by_id, w) for w in wanted]
    if len(ids) == 1:
        blast = reachable(inn, ids[0])
        return sorted(blast), "blast radius of %s: %d nodes reach it" % (ids[0], len(blast) - 1)
    path = shortest_path(out, ids[0], ids[1])
    if not path:
        return ids, "no path from %s to %s - endpoints only" % (ids[0], ids[1])
    return path, "shortest path %s -> %s: %d hops" % (ids[0], ids[1], len(path) - 1)


def check_data(data, graph):
    """Arithmetic checks run before a byte is written; a failure is a generator bug."""
    ids = {n["id"] for n in graph["nodes"]}
    if data["built_at_commit"] != graph["built_at_commit"]:
        die("embedded commit %s differs from graph.json's %s"
            % (data["built_at_commit"], graph["built_at_commit"]))
    embedded = sum(len(c["nodes"]) for c in data["communities"])
    if embedded != len(ids):
        die("embedded %d nodes but the graph has %d" % (embedded, len(ids)))
    embedded_edges = sum(len(c["iedges"]) for c in data["communities"]) + sum(
        1 for c in data["communities"] for x in c["xedges"] if x[3] == "out")
    if embedded_edges != len(graph["edges"]):
        die("embedded %d edges but the graph has %d" % (embedded_edges, len(graph["edges"])))
    # Every hop against the graph's own edges, not just id existence. `compute_flows` builds steps
    # by BFS over that same adjacency, so this can only fire on a future edit to the generator or on
    # hand-injected data - which is exactly the fabricated-but-plausible path R6 and trap 145 name:
    # real ids, the right endpoints, steps that no edge connects.
    pairs = {(src, dst) for src, dst, _rel in graph["edges"]}
    for flow in data["flows"]:
        missing = [s for s in flow["steps"] if s not in ids]
        if missing:
            die('flow "%s" renders steps that are not in the graph: %s'
                % (flow["name"], ", ".join(missing)))
        if flow["steps"] and (flow["steps"][0] != flow["from"]
                              or flow["steps"][-1] != flow["to"]):
            die('flow "%s": rendered path does not run from %s to %s'
                % (flow["name"], flow["from"], flow["to"]))
        for a, b in zip(flow["steps"], flow["steps"][1:]):
            if (a, b) not in pairs:
                die('flow "%s": no edge %s -> %s, so the rendered path is not a path in the graph'
                    % (flow["name"], a, b))
    for nid in data["highlight"]:
        if nid not in ids:
            die("highlight node %s is not in the graph" % nid)


def embed_json(data):
    """JSON that is safe inside a <script> element and inside an HTML attribute-free text node."""
    blob = json.dumps(data, separators=(",", ":"), ensure_ascii=False)
    return blob.replace("<", "\\u003c").replace(">", "\\u003e").replace("&", "\\u0026")


